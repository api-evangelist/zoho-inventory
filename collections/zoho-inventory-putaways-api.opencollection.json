            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://accounts.zoho.com/oauth/v2/auth",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          },
          "docs": "Returns all comments recorded on a putaway."
        },
        {
          "info": {
            "name": "Attach files to a putaway",
            "type": "http"
