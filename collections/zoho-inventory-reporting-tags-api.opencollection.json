            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://accounts.zoho.com/oauth/v2/auth",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          },
          "docs": "Create a reporting tag"
        },
        {
          "info": {
            "name": "Mark an option as default for a reporting tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.zohoapis.com/inventory/v1/reportingtags/:tag_id",
            "params": [
              {
                "name": "organization_id",
                "value": "10234695",
                "type": "query",
                "description": "ID of the organization"
              },
              {
                "name": "tag_id",
                "value": "460000000038080",
                "type": "path",
                "description": "ID of the reporting tag"
              },
              {
                "name": "default_option_id",
                "value": "",
                "type": "query",
                "description": "ID of the option to be marked as default. If this parameter is not sent or sent empty, the current default option of the tag will be removed."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://accounts.zoho.com/oauth/v2/auth",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          },
          "docs": "Mark an option as the default option or clear default option for a reporting tag."
        },
        {
          "info": {
            "name": "Update Reporting Tag",
            "type": "http"
