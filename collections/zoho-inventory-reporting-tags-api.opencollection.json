          "docs": "Delete a reporting tag. If there are any usages of the reporting tag in transactions,  custom views or workflows, you will not be able to delete the tag."
        },
        {
          "info": {
            "name": "Update Reporting Tag Options",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.zohoapis.com/inventory/v1/reportingtags/:tag_id/options",
            "params": [
              {
                "name": "organization_id",
                "value": "10234695",
                "type": "query",
                "description": "ID of the organization"
              },
              {
                "name": "tag_id",
                "value": "460000000038080",
                "type": "path",
                "description": "ID of the reporting tag"
              }
